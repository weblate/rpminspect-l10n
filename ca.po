"Compareu les construccions de paquets per al compliment de les polítiques i "
"la consistència.\n"
"\n"

#: src/rpminspect.c:49
#, c-format
msgid "Usage: %s [OPTIONS] [before build] [after build]\n"
msgstr "Ús: %s [OPCIONS] [abans de construir] [després de construir]\n"

#: src/rpminspect.c:50
#, c-format
msgid "Options:\n"
msgstr "Opcions:\n"

#: src/rpminspect.c:51
#, c-format
msgid "  -c FILE, --config=FILE      Configuration file to use\n"
msgstr "  -c FITXER, --config,Fitxer de configuració a utilitzar\n"

#: src/rpminspect.c:52
#, c-format
msgid "  -p NAME, --profile=NAME     Configuration profile to use\n"
msgstr "  -p NOM, --profile,NOM Perfil de configuració a utilitzar\n"

#: src/rpminspect.c:53
#, c-format
msgid "  -T LIST, --tests=LIST       List of tests to run\n"
msgstr "  -T LIST, --tests ofLIST Llista de proves a executar\n"

#: src/rpminspect.c:54
#, c-format
msgid "                                (default: ALL)\n"
msgstr "                                (predeterminat: ALL)\n"

#: src/rpminspect.c:55
#, c-format
msgid "  -E LIST, --exclude=LIST     List of tests to exclude\n"
msgstr "  -E LIST, --exclude ofLIST Llista de proves a excloure\n"

#: src/rpminspect.c:56
#, c-format
msgid "                                (default: none)\n"
msgstr "                                (predeterminat: cap)\n"

#: src/rpminspect.c:57
#, c-format
msgid "  -a LIST, --arches=LIST      List of architectures to check\n"
msgstr "  -a LIST, --arches ofLIST Llista d'arquitectures a comprovar\n"

#: src/rpminspect.c:58
#, c-format
msgid "  -r STR, --release=STR       Product release string\n"
msgstr "  -r STR, --release,STR Cadena de llançament de producte\n"

#: src/rpminspect.c:59
#, c-format
msgid "  -n, --no-rebase             Disable build rebase detection\n"
msgstr "  -n, --no-rebase Desactiva la detecció de la base de dades\n"

#: src/rpminspect.c:60
#, c-format
msgid "  -b TYPE, --build-type=TYPE  Set Koji build type to TYPE\n"
msgstr ""
"  -b TYPE, --build-type,TYPE Estableix el tipus de construcció Koji a TYPE\n"

#: src/rpminspect.c:61
#, c-format
msgid "  -o FILE, --output=FILE      Write results to FILE\n"
msgstr "  -o FITXER, --output,FITXER Escriu resultats a FITXER\n"

#: src/rpminspect.c:62
#, c-format
msgid "                                (default: stdout)\n"
msgstr "                                (predeterminat: stdout)\n"

#: src/rpminspect.c:63
#, c-format
msgid "  -F TYPE, --format=TYPE      Format output results as TYPE\n"
msgstr "  -F TIPUS, --format,TIPUS Format resultats de sortida com A TIPUS\n"

#: src/rpminspect.c:64
#, c-format
msgid "                                (default: text)\n"
msgstr "                                (predeterminat: text)\n"

#: src/rpminspect.c:65
#, c-format
msgid "  -t TAG, --threshold=TAG     Result threshold triggering exit\n"
msgstr "  -t TAG, --threshold,TAG Llindar de resultat\n"

#: src/rpminspect.c:66
#, c-format
msgid "                              failure (default: VERIFY)\n"
msgstr "                              fallada (predeterminat: VERIFICA)\n"

#: src/rpminspect.c:67
#, c-format
msgid "  -s TAG, --suppress=TAG      Results suppression threshold\n"
msgstr "  -s TAG, --suppress,Suprimeix el llindar de supressió de resultats\n"

#: src/rpminspect.c:68
#, c-format
msgid "                                (default: off, report everything)\n"
msgstr ""
"                                (predeterminat: desactivat, informa-ho tot)\n"

#: src/rpminspect.c:69
#, c-format
msgid "  -l, --list                  List available tests and formats\n"
msgstr "  -l, --list Llista de proves i formats disponibles\n"

#: src/rpminspect.c:70
#, c-format
msgid "  -w PATH, --workdir=PATH     Temporary directory to use\n"
msgstr "  -w PATH, --workdir,CAMÍ Directori temporal a utilitzar\n"

#: src/rpminspect.c:71
#, c-format
msgid "                                (default: %s)\n"
msgstr "                                (predeterminat: %s)\n"

#: src/rpminspect.c:72
#, c-format
msgid ""
"  -f, --fetch-only            Fetch builds only, do not perform inspections\n"
msgstr "  -f, --fetch-only Fetch builds only, no realitzeu inspeccions\n"

#: src/rpminspect.c:73
#, c-format
msgid "                                (implies -k)\n"
msgstr "                                (implica -k)\n"

#: src/rpminspect.c:74
#, c-format
msgid ""
"  -k, --keep                  Do not remove the comparison working files\n"
msgstr "  -k, --keep No eliminis els fitxers de treball de comparació\n"

