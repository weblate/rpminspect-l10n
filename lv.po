#: src/rpminspect.c:48
#, c-format
msgid ""
"Compare package builds for policy compliance and consistency.\n"
"\n"
msgstr ""
"Salīdzināt pakotņu būves politiku ievērošanas un konsekvences nolūkā.\n"
"\n"

#: src/rpminspect.c:49
#, c-format
msgid "Usage: %s [OPTIONS] [before build] [after build]\n"
msgstr "Lietošana: %s [OPCIJAS] [būve pirms] [būve pēc]\n"

#: src/rpminspect.c:50
#, c-format
msgid "Options:\n"
msgstr "Opcijas:\n"

#: src/rpminspect.c:51
#, c-format
msgid "  -c FILE, --config=FILE      Configuration file to use\n"
msgstr "  -c FAILS, --config=FAILS    Izmantojamais konfigurācijas fails\n"

#: src/rpminspect.c:52
#, c-format
msgid "  -p NAME, --profile=NAME     Configuration profile to use\n"
msgstr "  -p NOS, --profile=NOS       Izmantojamais konfigurācijas profils\n"

#: src/rpminspect.c:53
#, c-format
msgid "  -T LIST, --tests=LIST       List of tests to run\n"
msgstr "  -T SAR, --tests=SAR         Izpildāmo testu saraksts\n"

#: src/rpminspect.c:54
#, c-format
msgid "                                (default: ALL)\n"
msgstr "                                (noklusējums: ALL)\n"

#: src/rpminspect.c:55
#, c-format
msgid "  -E LIST, --exclude=LIST     List of tests to exclude\n"
msgstr "  -E SAR, --exclude=SAR       Izslēdzamo testu saraksts\n"

#: src/rpminspect.c:56
#, c-format
msgid "                                (default: none)\n"
msgstr "                                (noklusējums: neviens)\n"

#: src/rpminspect.c:57
#, c-format
msgid "  -a LIST, --arches=LIST      List of architectures to check\n"
msgstr "  -a SAR, --arches=SAR        Pārbaudāmo arhitektūru saraksts\n"

#: src/rpminspect.c:58
#, c-format
msgid "  -r STR, --release=STR       Product release string\n"
msgstr "  -r VIRK, --release=VIRK     Produkta laidiena virkne\n"

#: src/rpminspect.c:59
#, c-format
msgid "  -n, --no-rebase             Disable build rebase detection\n"
msgstr "  -n, --no-rebase             Atspējot būves pārbāzēšanas noteikšanu\n"

#: src/rpminspect.c:60
#, c-format
msgid "  -b TYPE, --build-type=TYPE  Set Koji build type to TYPE\n"
msgstr "  -b TIPS, --build-type=TIPS  Iestatīt Koji būves tipu uz TIPS\n"

#: src/rpminspect.c:61
#, c-format
msgid "  -o FILE, --output=FILE      Write results to FILE\n"
msgstr "  -o FAILS, --output=FAILS    Rakstīt rezultātus FAILĀ\n"

#: src/rpminspect.c:62
#, c-format
msgid "                                (default: stdout)\n"
msgstr "                                (noklusējums: stdout)\n"

#: src/rpminspect.c:63
#, c-format
msgid "  -F TYPE, --format=TYPE      Format output results as TYPE\n"
msgstr "  -F TIPS, --format=TIPS      Formatēt izvades rezultātus kā TIPS\n"

#: src/rpminspect.c:64
#, c-format
msgid "                                (default: text)\n"
msgstr "                                (noklusējums: text)\n"

#: src/rpminspect.c:65
#, c-format
msgid "  -t TAG, --threshold=TAG     Result threshold triggering exit\n"
msgstr ""
"  -t TAGS, --threshold=TAGS   Rezultāta slieksnis, kas izraisa iziešanu\n"

#: src/rpminspect.c:66
#, c-format
msgid "                              failure (default: VERIFY)\n"
msgstr "                              ar kļūmi (noklusējums: VERIFY)\n"

#: src/rpminspect.c:67
#, c-format
msgid "  -s TAG, --suppress=TAG      Results suppression threshold\n"
msgstr "  -s TAGS, --suppress=TAGS    Rezultātu apslāpēšanas slieksnis\n"

#: src/rpminspect.c:68
#, c-format
msgid "                                (default: off, report everything)\n"
msgstr "                                (noklusējums: off, ziņot par visu)\n"

#: src/rpminspect.c:69
#, c-format
msgid "  -l, --list                  List available tests and formats\n"
msgstr "  -l, --list                  Uzskaitīt pieejamos testus un formātus\n"

#: src/rpminspect.c:70
#, c-format
msgid "  -w PATH, --workdir=PATH     Temporary directory to use\n"
msgstr "  -w CEĻŠ, --workdir=CEĻŠ     Izmantojamā pagaidu direktorija\n"

#: src/rpminspect.c:71
#, c-format
msgid "                                (default: %s)\n"
msgstr "                                (noklusējums: %s)\n"

#: src/rpminspect.c:72
#, c-format
msgid ""
"  -f, --fetch-only            Fetch builds only, do not perform inspections\n"
msgstr "  -f, --fetch-only            Tikai ienest būves, neveikt pārbaudes\n"

#: src/rpminspect.c:73
#, c-format
msgid "                                (implies -k)\n"
msgstr "                                (ietver -k)\n"

#: src/rpminspect.c:74
#, c-format
msgid ""
"  -k, --keep                  Do not remove the comparison working files\n"
msgstr "  -k, --keep                  Nenoņemt salīdzināšanas darba failus\n"

#: src/rpminspect.c:75
#, c-format
msgid "  -d, --debug                 Debugging mode output\n"
msgstr "  -d, --debug                 Atkļūdošanas režīma izvade\n"

#: src/rpminspect.c:76
#, c-format
msgid ""
"  -D, --dump-config           Dump configuration settings (in YAML format)\n"
msgstr ""
"  -D, --dump-config           Izmest konfigurācijas iestatījumus (YAML "
"formātā)\n"

#: src/rpminspect.c:77
#, c-format
msgid "  -v, --verbose               Verbose inspection output\n"
msgstr "  -v, --verbose               Detalizēta pārbaužu izvade\n"

#: src/rpminspect.c:78
#, c-format
msgid "                              when finished, display full path\n"
msgstr "                              pēc pabeigšanas parādīt pilnu ceļu\n"

#: src/rpminspect.c:79
#, c-format
msgid "  -?, --help                  Display usage information\n"
msgstr "  -?, --help                  Parādīt lietošanas informāciju\n"

#: src/rpminspect.c:80
#, c-format
msgid "  -V, --version               Display program version\n"
msgstr "  -V, --version               Parādīt programmas versiju\n"

