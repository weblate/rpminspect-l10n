msgstr "*** ຮູບແບບຕົວລະບຸລະດັບ ABI ບໍ່ຖືກຕ້ອງ: %s"

#: lib/abi.c:70
#, c-format
msgid "*** ABI level %d already defined"
msgstr "*** ລະດັບ ABI %d ຖືກກຳນົດໄວ້ແລ້ວ"

#: lib/abi.c:84
#, c-format
msgid "*** malformed ABI level entry: %s"
msgstr "*** ຮູບແບບລາຍການລະດັບ ABI ບໍ່ຖືກຕ້ອງ: %s"

#: lib/builds.c:73
#, c-format
msgid "*** unable to create download directory %s"
msgstr "*** ບໍ່ສາມາດສ້າງໄດເຣັກທໍຣີດາວໂຫຼດ %s"

#: lib/builds.c:85
#, c-format
msgid "*** unknown working directory type: %d"
msgstr "*** ບໍ່ຮູ້ຈັກປະເພດໄດເຣັກທໍຣີເຮັດວຽກ: %d"

#: lib/builds.c:173
#, c-format
msgid "*** unable to read %s, skipping"
msgstr "*** ບໍ່ສາມາດອ່ານ %s, ກຳລັງຂ້າມໄປ"

#: lib/builds.c:205
#, c-format
msgid "*** unknown directory member encountered: %s"
msgstr "*** ພົບສະມາຊິກໄດເຣັກທໍຣີທີ່ບໍ່ຮູ້ຈັກ: %s"

#: lib/builds.c:234
#, c-format
msgid "There is not enough available space to download the requested %s.\n"
msgstr "ພື້ນທີ່ຫວ່າງບໍ່ພໍທີ່ຈະດາວໂຫຼດ %s ທີ່ຕ້ອງການ.\n"

#: lib/builds.c:235 lib/peers.c:177
#, c-format
msgid "    Need %s in %s, have %s.\n"
msgstr "    ຕ້ອງການ %s ໃນ %s, ແຕ່ມີພຽງ %s.\n"

#: lib/builds.c:236 lib/peers.c:178
#, c-format
msgid "See the `-w' option for specifying an alternate working directory.\n"
msgstr "ເບິ່ງຕົວເລືອກ `-w' ເພື່ອກຳນົດໄດເຣັກທໍຣີເຮັດວຽກອື່ນ.\n"

#: lib/builds.c:249
#, c-format
msgid "Unable to determine the required space to download the requested %s.\n"
msgstr "ບໍ່ສາມາດຄຳນວນພື້ນທີ່ທີ່ຕ້ອງການເພື່ອດາວໂຫຼດ %s ໄດ້.\n"

#: lib/builds.c:250
#, c-format
msgid "Ensure %s has sufficient space available."
msgstr "ກວດສອບໃຫ້ແນ່ໃຈວ່າ %s ມີພື້ນທີ່ຫວ່າງພຽງພໍ."

#: lib/builds.c:290 lib/builds.c:294
msgid "build"
msgstr "ການບິວ (build)"

#: lib/builds.c:320
