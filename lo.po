#: src/rpminspect.c:48
#, c-format
msgid ""
"Compare package builds for policy compliance and consistency.\n"
"\n"
msgstr ""
"ປຽບທຽບການບິວແພັກເກດເພື່ອຄວາມຖືກຕ້ອງຕາມນະໂຍບາຍ ແລະ ຄວາມສອດຄ່ອງ.\n"
"\n"

#: src/rpminspect.c:49
#, c-format
msgid "Usage: %s [OPTIONS] [before build] [after build]\n"
msgstr "ວິທີໃຊ້: %s [ຕົວເລືອກ] [ການບິວກ່ອນໜ້າ] [ການບິວຫຼັງຈາກ]\n"

#: src/rpminspect.c:50
#, c-format
msgid "Options:\n"
msgstr "ຕົວເລືອກ:\n"

#: src/rpminspect.c:51
#, c-format
msgid "  -c FILE, --config=FILE      Configuration file to use\n"
msgstr "  -c FILE, --config=FILE      ໄຟລ໌ການຕັ້ງຄ່າທີ່ຈະໃຊ້\n"

#: src/rpminspect.c:52
#, c-format
msgid "  -p NAME, --profile=NAME     Configuration profile to use\n"
msgstr "  -p NAME, --profile=NAME     ໂປຣໄຟລ໌ການຕັ້ງຄ່າທີ່ຈະໃຊ້\n"

#: src/rpminspect.c:53
#, c-format
msgid "  -T LIST, --tests=LIST       List of tests to run\n"
msgstr "  -T LIST, --tests=LIST       ລາຍການການທົດສອບທີ່ຈະລັນ\n"

#: src/rpminspect.c:54
#, c-format
msgid "                                (default: ALL)\n"
msgstr "                                (ຄ່າມາຕຖານ: ທັງໝົດ)\n"

#: src/rpminspect.c:55
#, c-format
msgid "  -E LIST, --exclude=LIST     List of tests to exclude\n"
msgstr "  -E LIST, --exclude=LIST     ລາຍການການທົດສອບທີ່ຈະຍົກເວັ້ນ\n"

#: src/rpminspect.c:56
#, c-format
msgid "                                (default: none)\n"
msgstr "                                (ຄ່າມາຕຖານ: ບໍ່ມີ)\n"

#: src/rpminspect.c:57
#, c-format
msgid "  -a LIST, --arches=LIST      List of architectures to check\n"
msgstr "  -a LIST, --arches=LIST      ລາຍການສະຖາປັດຕະຍະກຳທີ່ຈະກວດສອບ\n"

#: src/rpminspect.c:58
#, c-format
msgid "  -r STR, --release=STR       Product release string\n"
msgstr "  -r STR, --release=STR       ຂໍ້ຄວາມເວີຊັນການປ່ອຍຜະລິດຕະພັນ\n"

#: src/rpminspect.c:59
#, c-format
msgid "  -n, --no-rebase             Disable build rebase detection\n"
msgstr "  -n, --no-rebase             ປິດການກວດສອບ build rebase\n"

#: src/rpminspect.c:60
#, c-format
msgid "  -b TYPE, --build-type=TYPE  Set Koji build type to TYPE\n"
msgstr "  -b TYPE, --build-type=TYPE  ຕັ້ງຄ່າປະເພດການບິວຂອງ Koji ເປັນ TYPE\n"

#: src/rpminspect.c:61
#, c-format
msgid "  -o FILE, --output=FILE      Write results to FILE\n"
msgstr "  -o FILE, --output=FILE      ຂຽນຜົນລັບລົງໃນໄຟລ໌\n"

#: src/rpminspect.c:62
#, c-format
msgid "                                (default: stdout)\n"
msgstr "                                (ຄ່າມາຕຖານ: stdout)\n"

#: src/rpminspect.c:63
#, c-format
msgid "  -F TYPE, --format=TYPE      Format output results as TYPE\n"
msgstr "  -F TYPE, --format=TYPE      ກຳນົດຮູບແບບຜົນລັບເປັນ TYPE\n"

#: src/rpminspect.c:64
#, c-format
msgid "                                (default: text)\n"
msgstr "                                (ຄ່າມາຕຖານ: text)\n"

#: src/rpminspect.c:65
#, c-format
msgid "  -t TAG, --threshold=TAG     Result threshold triggering exit\n"
msgstr ""
"  -t TAG, --threshold=TAG     ກຳນົດລະດັບຜົນລັບ (threshold) ທີ່ຈະໃຫ້ໂປຣແກຣມຢຸດເຮັດວຽກ\n"

#: src/rpminspect.c:66
#, c-format
msgid "                              failure (default: VERIFY)\n"
msgstr "                              ເມື່ອລົ້ມເຫຼວ (ຄ່າມາຕຖານ: VERIFY)\n"

#: src/rpminspect.c:67
#, c-format
msgid "  -s TAG, --suppress=TAG      Results suppression threshold\n"
msgstr "  -s TAG, --suppress=TAG      ລະດັບໃນການປິດການສະແດງຜົນລັບ\n"

#: src/rpminspect.c:68
#, c-format
msgid "                                (default: off, report everything)\n"
msgstr "                                (ຄ່າມາຕຖານ: ປິດ, ລາຍງານທຸກຢ່າງ)\n"

#: src/rpminspect.c:69
#, c-format
msgid "  -l, --list                  List available tests and formats\n"
msgstr ""
"  -l, --list                  ສະແດງລາຍການການທົດສອບ ແລະ ຮູບແບບທີ່ມີໃຫ້ໃຊ້\n"

#: src/rpminspect.c:70
#, c-format
msgid "  -w PATH, --workdir=PATH     Temporary directory to use\n"
msgstr "  -w PATH, --workdir=PATH     ໄດເຣັກທໍຣີຊົ່ວຄາວທີ່ຈະໃຊ້\n"

#: src/rpminspect.c:71
#, c-format
msgid "                                (default: %s)\n"
msgstr "                                (ຄ່າມາຕຖານ: %s)\n"

#: src/rpminspect.c:72
#, c-format
msgid ""
"  -f, --fetch-only            Fetch builds only, do not perform inspections\n"
msgstr ""
"  -f, --fetch-only            ດຶງຂໍ້ມູນການບິວເທົ່ານັ້ນ, ໂດຍບໍ່ຕ້ອງທຳການກວດສອບ\n"

#: src/rpminspect.c:73
#, c-format
msgid "                                (implies -k)\n"
msgstr "                                (ໝາຍເຖິງການໃຊ້ -k ໄປນຳ)\n"

#: src/rpminspect.c:74
#, c-format
msgid ""
"  -k, --keep                  Do not remove the comparison working files\n"
msgstr "  -k, --keep                  ບໍ່ຕ້ອງລຶບໄຟລ໌ທີ່ໃຊ້ໃນການປຽບທຽບອອກ\n"

#: src/rpminspect.c:75
#, c-format
msgid "  -d, --debug                 Debugging mode output\n"
msgstr "  -d, --debug                 ສະແດງຜົນໃນໂໝດ debug\n"

#: src/rpminspect.c:76
#, c-format
msgid ""
"  -D, --dump-config           Dump configuration settings (in YAML format)\n"
msgstr ""
"  -D, --dump-config           ສະແດງຄ່າການຕັ້ງຄ່າທັງໝົດ (ໃນຮູບແບບ YAML)\n"

#: src/rpminspect.c:77
#, c-format
msgid "  -v, --verbose               Verbose inspection output\n"
msgstr "  -v, --verbose               ສະແດງລາຍລະອຽດການກວດສອບແບບລະອຽດ\n"

#: src/rpminspect.c:78
#, c-format
msgid "                              when finished, display full path\n"
msgstr ""
"                              ເມື່ອສຳເລັດ, ໃຫ້ສະແດງເສັ້ນທາງເຕັມ (full path)\n"

#: src/rpminspect.c:79
