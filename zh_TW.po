msgstr "工作目錄中的磁碟空間不足。"

#: src/rpminspect.c:48
#, c-format
msgid ""
"Compare package builds for policy compliance and consistency.\n"
"\n"
msgstr ""
"比較套件建置以檢查政策合規性與一致性。\n"
"\n"

#: src/rpminspect.c:49
#, c-format
msgid "Usage: %s [OPTIONS] [before build] [after build]\n"
msgstr "用法：%s [選項] [前版本建置] [後版本建置]\n"

#: src/rpminspect.c:50
#, c-format
msgid "Options:\n"
msgstr "選項:\n"

#: src/rpminspect.c:51
#, c-format
msgid "  -c FILE, --config=FILE      Configuration file to use\n"
msgstr "  -c FILE, --config=FILE      使用的設定檔案\n"

#: src/rpminspect.c:52
#, c-format
msgid "  -p NAME, --profile=NAME     Configuration profile to use\n"
msgstr "  -p NAME, --profile=NAME     使用的設定檔\n"

#: src/rpminspect.c:53
#, c-format
msgid "  -T LIST, --tests=LIST       List of tests to run\n"
msgstr "  -T LIST, --tests=LIST       要執行的測試清單\n"

#: src/rpminspect.c:54
#, c-format
msgid "                                (default: ALL)\n"
msgstr "                                （預設：ALL）\n"

#: src/rpminspect.c:55
#, c-format
msgid "  -E LIST, --exclude=LIST     List of tests to exclude\n"
msgstr "  -E LIST, --exclude=LIST     要排除的測試清單\n"

#: src/rpminspect.c:56
#, c-format
msgid "                                (default: none)\n"
msgstr "                                （預設：無）\n"

#: src/rpminspect.c:57
#, c-format
msgid "  -a LIST, --arches=LIST      List of architectures to check\n"
msgstr "  -a LIST, --arches=LIST      要檢查的架構清單\n"

#: src/rpminspect.c:58
#, c-format
msgid "  -r STR, --release=STR       Product release string\n"
msgstr "  -r STR, --release=STR       產品發行版本字串\n"

#: src/rpminspect.c:59
#, c-format
msgid "  -n, --no-rebase             Disable build rebase detection\n"
msgstr "  -n, --no-rebase             停用建置 rebase 偵測\n"

#: src/rpminspect.c:60
#, c-format
msgid "  -b TYPE, --build-type=TYPE  Set Koji build type to TYPE\n"
msgstr "  -b TYPE, --build-type=TYPE  設定 Koji 建置類型為 TYPE\n"

#: src/rpminspect.c:61
#, c-format
msgid "  -o FILE, --output=FILE      Write results to FILE\n"
msgstr "  -o FILE, --output=FILE      將結果寫入 FILE\n"

#: src/rpminspect.c:62
#, c-format
msgid "                                (default: stdout)\n"
msgstr "                                （預設：stdout）\n"

#: src/rpminspect.c:63
#, c-format
msgid "  -F TYPE, --format=TYPE      Format output results as TYPE\n"
msgstr "  -F TYPE, --format=TYPE      以 TYPE 格式輸出結果\n"

#: src/rpminspect.c:64
#, c-format
msgid "                                (default: text)\n"
msgstr "                                （預設：text）\n"

#: src/rpminspect.c:65
#, c-format
msgid "  -t TAG, --threshold=TAG     Result threshold triggering exit\n"
msgstr "  -t TAG, --threshold=TAG     觸發退出的結果閾值\n"

#: src/rpminspect.c:66
#, c-format
msgid "                              failure (default: VERIFY)\n"
msgstr "                              失敗（預設：VERIFY）\n"

#: src/rpminspect.c:67
#, c-format
msgid "  -s TAG, --suppress=TAG      Results suppression threshold\n"
msgstr "  -s TAG, --suppress=TAG      結果抑制閾值\n"

#: src/rpminspect.c:68
#, c-format
msgid "                                (default: off, report everything)\n"
msgstr "                                （預設：關閉，回報所有項目）\n"

#: src/rpminspect.c:69
#, c-format
msgid "  -l, --list                  List available tests and formats\n"
msgstr "  -l, --list                  列出可用的測試與格式\n"

#: src/rpminspect.c:70
#, c-format
msgid "  -w PATH, --workdir=PATH     Temporary directory to use\n"
msgstr "  -w PATH, --workdir=PATH     使用的暫存目錄\n"

#: src/rpminspect.c:71
#, c-format
msgid "                                (default: %s)\n"
msgstr "                                （預設：%s）\n"

#: src/rpminspect.c:72
#, c-format
msgid ""
"  -f, --fetch-only            Fetch builds only, do not perform inspections\n"
msgstr "  -f, --fetch-only            僅擷取建置，不執行檢查\n"

#: src/rpminspect.c:73
#, c-format
msgid "                                (implies -k)\n"
msgstr "                                （隱含 -k）\n"

#: src/rpminspect.c:74
#, c-format
msgid ""
"  -k, --keep                  Do not remove the comparison working files\n"
msgstr "  -k, --keep                  不移除比較用的工作檔案\n"

#: src/rpminspect.c:75
#, c-format
msgid "  -d, --debug                 Debugging mode output\n"
msgstr "  -d, --debug                 除錯模式輸出\n"

#: src/rpminspect.c:76
#, c-format
msgid ""
"  -D, --dump-config           Dump configuration settings (in YAML format)\n"
msgstr "  -D, --dump-config           傾印設定值（YAML 格式）\n"

#: src/rpminspect.c:77
#, c-format
msgid "  -v, --verbose               Verbose inspection output\n"
msgstr "  -v, --verbose               詳細檢查輸出\n"

#: src/rpminspect.c:78
#, c-format
msgid "                              when finished, display full path\n"
msgstr "                              完成時顯示完整路徑\n"

#: src/rpminspect.c:79
#, c-format
msgid "  -?, --help                  Display usage information\n"
msgstr "  -?, --help                  顯示使用資訊\n"

#: src/rpminspect.c:80
#, c-format
msgid "  -V, --version               Display program version\n"
msgstr "  -V, --version               顯示程式版本\n"

#: src/rpminspect.c:81
#, c-format
msgid ""
"\n"
"See the rpminspect(1) man page for more information.\n"
msgstr ""
"\n"
"詳見 rpminspect(1) 手冊頁面以取得更多資訊。\n"

